---
import "@/styles/global.css";
import Menu from "./menu.astro";
import NoiseSvg from "@/img/noise.svg";
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>ForSureItsMe{title ? ` - ${title}` : ""}</title>
	</head>
	<body>
		<Menu />
		<slot />
	</body>
</html>

<style
	type="text/css"
	define:vars={{
		"noise-url": `url(${NoiseSvg.src})`,
	}}
>
	html {
		background-image: linear-gradient(
			to right,
			var(--purple),
			var(--lilac),
			var(--purple)
		);
	}

	html:before {
		content: '';
		background-image: var(--noise-url);
		opacity: 20%;
		position: absolute;
		inset: 0;
	}

	body {
		min-height: 100vh;
		margin: 0;
	}

</style>
